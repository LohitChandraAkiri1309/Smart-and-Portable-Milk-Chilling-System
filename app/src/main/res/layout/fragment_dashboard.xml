<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Collection Center Live Grid"
        android:textColor="#F8F9FA"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SIH26110 • Cold-Chain Real-Time Observability (Java)"
        android:textColor="#00E5FF"
        android:textSize="13sp" />

    <!-- KPI Summary Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#2B3A4E"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Safe" android:textColor="#8D99AE" android:textSize="11sp" />
            <TextView android:id="@+id/tv_safe_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#00E676" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#2B3A4E"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warning" android:textColor="#8D99AE" android:textSize="11sp" />
            <TextView android:id="@+id/tv_warning_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFB300" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#2B3A4E"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breach" android:textColor="#8D99AE" android:textSize="11sp" />
            <TextView android:id="@+id/tv_breach_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF5252" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#2B3A4E"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline" android:textColor="#8D99AE" android:textSize="11sp" />
            <TextView android:id="@+id/tv_offline_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#78909C" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Active Chilling Cans"
        android:textColor="#F8F9FA"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp" />

</LinearLayout>
