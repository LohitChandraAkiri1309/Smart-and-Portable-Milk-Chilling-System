<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Can Telemetry &amp; Chilling Curve"
            android:textColor="#F8F9FA"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Headline Judge Metric Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#2B3A4E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEADLINE JUDGE METRIC"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Time to Target (35°C → 4°C)"
            android:textColor="#8D99AE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_time_to_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="68 Mins"
            android:textColor="#00E676"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Java Canvas Graph View -->
    <com.sih.milkchilling.ui.components.ChillingCurveView
        android:id="@+id/chilling_chart"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Raw Telemetry Stream Audit Log"
        android:textColor="#F8F9FA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_readings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />

</LinearLayout>
