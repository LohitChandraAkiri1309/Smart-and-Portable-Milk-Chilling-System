<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#2B3A4E"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_can_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Can #1"
                android:textColor="#F8F9FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_can_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: CAN-ESP32-01 • Farmer: Ramesh"
                android:textColor="#8D99AE"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_can_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#1500E676"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="SAFE (&lt;4°C)"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/tv_can_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.8°C"
            android:textColor="#F8F9FA"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_can_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi Online"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_can_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Battery: 92%"
                android:textColor="#E0E1DD"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
