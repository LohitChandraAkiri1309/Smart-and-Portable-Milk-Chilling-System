<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 Hardware Simulator (Java)"
            android:textColor="#F8F9FA"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SIH Judge Demo Control Panel • Offline Buffer &amp; Burst Sync"
            android:textColor="#8D99AE"
            android:textSize="12sp" />

        <!-- Node Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#2B3A4E"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Node: CAN-ESP32-01"
                    android:textColor="#F8F9FA"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sim_wifi_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="ONLINE"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp" android:textColor="#8D99AE" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_sim_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="35.5°C" android:textColor="#F8F9FA" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elapsed" android:textColor="#8D99AE" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_sim_mins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Mins" android:textColor="#00E5FF" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPIFFS Buffer" android:textColor="#8D99AE" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_sim_buffered" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Records" android:textColor="#FFB300" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sim_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0D1B2A"
                android:padding="8dp"
                android:text="Ready for demo"
                android:textColor="#E0E1DD"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SIH Judge Demonstration Actions"
            android:textColor="#F8F9FA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_start_sim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#00E5FF"
            android:text="Start Normal Chilling Cycle (35°C → 3.8°C)"
            android:textColor="#0D1B2A"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFB300"
            android:text="Simulate WiFi Disconnect (Buffer in ESP32 Flash)"
            android:textColor="#0D1B2A"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_inject_breach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF5252"
            android:text="Inject Thermal Breach Anomaly (&gt;8°C)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_stop_sim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#415A77"
            android:text="Stop Simulation"
            android:textColor="#F8F9FA" />

    </LinearLayout>
</ScrollView>
