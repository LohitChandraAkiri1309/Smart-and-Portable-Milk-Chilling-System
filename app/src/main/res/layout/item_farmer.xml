<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#2B3A4E"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_farmer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ramesh Kumar"
            android:textColor="#F8F9FA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_farmer_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: +91 98765 43210 • Anand Village"
            android:textColor="#8D99AE"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_farmer_can"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="Can: CAN-ESP32-01"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>
